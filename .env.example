SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL. Leave DATABASE_URL empty.
DB_NAME=amazon_clone
DB_USER=your_postgres_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Render sets this from the linked PostgreSQL database.
# DATABASE_URL=postgres://user:password@host:5432/amazone
# DB_SSL=True
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
